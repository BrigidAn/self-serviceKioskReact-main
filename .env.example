# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is git-ignored — never commit real secrets.

# SQL Server 'sa' password (min 8 chars, upper + lower + digit + symbol)
SA_PASSWORD=Change_Me_123!

# JWT signing key, at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string-of-at-least-32-chars

# Optional: Cloudinary credentials for product image uploads (leave blank to skip)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Host ports
WEB_PORT=3000
API_PORT=8080
